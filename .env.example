###############################################################################
# AddisPay environment template
# Copy:  cp .env.example .env
# Never commit real secrets. On Render, set these in the Dashboard → Environment.
###############################################################################

# ========== Public URLs ==========
# Browser-facing site + API (must be HTTPS in production)
FRONTEND_URL=https://your-frontend.onrender.com
CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com
NEXT_PUBLIC_API_BASE_URL=https://your-api.onrender.com/api/v1
NEXT_PUBLIC_SITE_URL=https://your-frontend.onrender.com

# ========== Docker Compose ports (local only) ==========
BACKEND_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5432

# ========== PostgreSQL ==========
POSTGRES_USER=addispay
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=addispay_db

# Discrete vars (Compose / self-host). On Render prefer DATABASE_URL.
DB_HOST=db
DB_PORT=5432
DB_USER=addispay
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_NAME=addispay_db
DB_SSLMODE=disable

# Render managed Postgres connection string (overrides DB_* when set)
# postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# ========== Auth ==========
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
ADDISPAY_JWT_SUPER_SECRET_KEY_2026=REPLACE_WITH_LONG_RANDOM_SECRET

# ========== File uploads ==========
# Local / Compose / Render free plan: /app/uploads
# (Render free has no Persistent Disk — uploads reset on redeploy)
UPLOAD_DIR=/app/uploads

# ========== SMTP ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=AddisPay <noreply@yourdomain.com>

# ========== Runtime ==========
PORT=8080
GIN_MODE=release
NODE_ENV=production
