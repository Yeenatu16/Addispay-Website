# Backend-only reference (local `go run` / Render API service).
# Prefer root `.env` for Compose. On Render, set these in the API service.

PORT=8080
GIN_MODE=release

# Either discrete vars…
DB_HOST=localhost
DB_PORT=5432
DB_USER=addispay
DB_PASSWORD=
DB_NAME=addispay_db
DB_SSLMODE=disable

# …or Render Postgres URL (preferred on Render)
# DATABASE_URL="postgresql://user:password@localhost:5432/addispay_db?schema=public"

ADDISPAY_JWT_SUPER_SECRET_KEY_2026=
JWT_SECRET=

FRONTEND_URL=https://your-frontend.onrender.com
CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com
UPLOAD_DIR=/var/data/uploads

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=AddisPay <noreply@yourdomain.com>
